# Portas do sistema (lidas pelo docker-compose.yml e pelo painel-demo).
# Este e o UNICO lugar do projeto com numeros de porta: o codigo Java, os
# application.properties/yml e os Dockerfiles nao tem nenhuma.
# Os 4 servicos de negocio nao aparecem aqui: eles sobem numa porta aleatoria
# (server.port=0), registram essa porta no Eureka e ficam so na rede interna do Docker.

# API Gateway: unica porta de entrada da aplicacao (http://localhost:<GATEWAY_PORT>)
GATEWAY_PORT=8080

# Service Discovery (Eureka): painel com os servicos registrados (http://localhost:<EUREKA_PORT>)
EUREKA_PORT=8761

# Mailpit: caixa de e-mail de teste, aberta no navegador (http://localhost:<MAILPIT_WEB_PORT>)
MAILPIT_WEB_PORT=8025

# Mailpit: servidor SMTP usado pelo Servico de Notificacoes (so dentro da rede do Docker)
MAILPIT_SMTP_PORT=1025
